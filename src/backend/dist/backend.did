type UserRole = 
 variant {
   areaInCharge;
   contractorAdmin;
   departmentHOD;
   ehsManager;
   employee;
   safetyOfficer;
   supervisor;
   systemAdmin;
 };
type UserRecord = 
 record {
   active: bool;
   department: text;
   email: text;
   employeeNumber: text;
   id: UserId;
   mobileNumber: text;
   name: text;
   role: UserRole;
 };
type UserId = text;
type TrainingStatus = 
 variant {
   completed;
   notStarted;
   overdue;
   pending;
 };
type TrainingRecord = 
 record {
   completionDate: opt Timestamp;
   course: text;
   employeeId: text;
   employeeName: text;
   expiryDate: opt Timestamp;
   id: RecordId;
   score: opt nat;
   status: TrainingStatus;
 };
type ToolboxTalk = 
 record {
   attendeesCount: nat;
   conductedAt: text;
   conductedBy: text;
   keyPoints: text;
 };
type Timestamp = int;
type SafetyScoreSplit = 
 record {
   compliance: nat;
   environment: nat;
   health: nat;
   safety: nat;
 };
type RiskStatus = 
 variant {
   approved;
   draft;
   submitted;
 };
type RiskRecord = 
 record {
   controls: vec text;
   createdAt: Timestamp;
   createdBy: text;
   hazard: text;
   id: RecordId;
   likelihood: nat;
   location: text;
   residualLikelihood: nat;
   residualSeverity: nat;
   riskLevel: RiskLevel;
   severity: nat;
   status: RiskStatus;
 };
type RiskLevel = 
 variant {
   critical;
   high;
   low;
   medium;
   veryLow;
 };
type Result_5 = 
 variant {
   err: text;
   ok: vec AttachmentMeta;
 };
type Result_4 = 
 variant {
   err: text;
   ok: AuthSession;
 };
type Result_3 = 
 variant {
   err: text;
   ok: text;
 };
type Result_2 = 
 variant {
   err: text;
   ok: ESGRecord;
 };
type Result_1 = 
 variant {
   err: text;
   ok;
 };
type Result = 
 variant {
   err: text;
   ok: bool;
 };
type RecordId = text;
type PersonInvolved = 
 record {
   department: text;
   employeeId: text;
   injuryType: text;
   name: text;
   role: text;
 };
type PermitType = 
 variant {
   confinedSpace;
   electrical;
   excavation;
   generalWorkPermit;
   heightWork;
   hotWork;
   liftingPermit;
   lineBreaking;
 };
type PermitStatus = 
 variant {
   active;
   approved;
   closed;
   draft;
   expired;
   rejected;
   submitted;
   underReview;
   validated;
 };
type PermitSignatures = 
 record {
   requestedBySignature: text;
   safetyOfficerSignature: text;
   supervisorSignature: text;
 };
type PermitRecord = 
 record {
   approvedBy: opt text;
   createdAt: Timestamp;
   emergencyContacts: opt vec EmergencyContact;
   endTime: Timestamp;
   gasTestResults: opt GasTestResults;
   hazardControls: opt vec HazardControl;
   hazards: vec text;
   id: RecordId;
   isolationTypes: opt vec text;
   isolationVerifiedBy: opt text;
   jobDescription: text;
   location: text;
   lotoApplied: opt bool;
   permitNumber: text;
   permitType: PermitType;
   ppeRequired: vec text;
   requestedBy: text;
   reviewedBy: opt text;
   signatures: opt PermitSignatures;
   startTime: Timestamp;
   status: PermitStatus;
   supervisorOnDuty: opt text;
   toolboxTalk: opt ToolboxTalk;
 };
type ObservationType = 
 variant {
   nearMiss;
   unsafeAct;
   unsafeCondition;
 };
type ObservationStatus = 
 variant {
   closed;
   inProgress;
   open;
 };
type ObservationRecord = 
 record {
   actions: vec text;
   attachments: opt vec AttachmentMeta;
   createdAt: Timestamp;
   description: text;
   id: RecordId;
   location: text;
   obsType: ObservationType;
   reportedBy: text;
   status: ObservationStatus;
 };
type ModuleOpenCounts = 
 record {
   capaItems: nat;
   incidents: nat;
   inspections: nat;
   observations: nat;
   permits: nat;
   risks: nat;
 };
type InspectionStatus = 
 variant {
   completed;
   inProgress;
   overdue;
   scheduled;
 };
type InspectionRecord = 
 record {
   area: text;
   createdAt: Timestamp;
   findings: vec text;
   id: RecordId;
   inspectionDate: Timestamp;
   inspector: text;
   score: nat;
   status: InspectionStatus;
   title: text;
 };
type IncidentTrendMonth = 
 record {
   critical: nat;
   high: nat;
   low: nat;
   medium: nat;
   month: text;
 };
type IncidentStatus = 
 variant {
   approved;
   closed;
   draft;
   escalated;
   overdue;
   rejected;
   submitted;
   underReview;
 };
type IncidentRecord = 
 record {
   actionsTaken: opt text;
   areaBarricaded: opt bool;
   attachments: opt vec AttachmentMeta;
   bodyPartAffected: opt text;
   contributingFactors: opt vec text;
   correctiveAction: opt text;
   createdAt: Timestamp;
   daysLost: opt nat;
   department: text;
   description: text;
   firstAidGiven: opt bool;
   id: RecordId;
   investigationDueDate: opt text;
   location: text;
   medicalTreatment: opt bool;
   natureOfInjury: opt text;
   personsInvolved: opt vec PersonInvolved;
   reportedBy: text;
   responsiblePerson: opt text;
   rootCause: opt text;
   rootCauseCategory: opt text;
   severity: text;
   status: IncidentStatus;
   targetDate: opt text;
   teamLead: opt text;
   teamMembers: opt vec text;
   ticketNumber: text;
   title: text;
   updatedAt: Timestamp;
 };
type HighRiskAlertDetail = 
 record {
   area: text;
   dueDate: text;
   escalationLevel: text;
   hazard: text;
   id: text;
   owner: text;
 };
type HazardControl = 
 record {
   control: text;
   hazard: text;
   residualRisk: text;
 };
type GasTestResults = 
 record {
   flammableGas: text;
   oxygenLevel: text;
   testTime: text;
   testedBy: text;
   toxicGas: text;
 };
type EnvironmentRecord = 
 record {
   createdAt: Timestamp;
   id: RecordId;
   location: text;
   notes: opt text;
   recordType: text;
   recordedBy: text;
   unit: text;
   value: float64;
 };
type EmergencyContact = 
 record {
   name: text;
   phone: text;
   role: text;
 };
type ESGStatus = 
 variant {
   approved;
   draft;
   rejected;
   submitted;
 };
type ESGSocial = 
 record {
   absenteeismRate: float64;
   communityEngagementPrograms: float64;
   contractorSafetyPerformance: float64;
   employeeSatisfactionIndex: float64;
   employeeTurnoverRate: float64;
   fatalities: float64;
   genderDiversityRatio: float64;
   grievanceCases: float64;
   ltifr: float64;
   occupationalHealthCases: float64;
   trainingHoursPerEmployee: float64;
   trir: float64;
   womenInWorkforce: float64;
 };
type ESGRecord = 
 record {
   approvedAt: Timestamp;
   approvedBy: text;
   dataSource: text;
   department: text;
   environmental: ESGEnvironmental;
   governance: ESGGovernance;
   id: RecordId;
   notes: text;
   period: text;
   periodType: text;
   recordedAt: Timestamp;
   recordedBy: UserId;
   recordedByName: text;
   social: ESGSocial;
   status: ESGStatus;
 };
type ESGGovernance = 
 record {
   antiCorruptionTrainingCoverage: float64;
   codeOfConductViolations: float64;
   complianceBreaches: float64;
   dataPrivacyIncidents: float64;
   policyComplianceScore: float64;
   regulatoryPenalties: float64;
   regulatoryViolations: float64;
   whistleblowerComplaints: float64;
 };
type ESGEnvironmental = 
 record {
   carbonEmissionIntensity: float64;
   energyConsumption: float64;
   envComplianceViolations: float64;
   renewableEnergyUsage: float64;
   wasteGenerated: float64;
   wasteRecyclingRate: float64;
   waterConsumption: float64;
   waterIntensity: float64;
   waterReuseRate: float64;
 };
type DepartmentRecord = 
 record {
   head: text;
   id: RecordId;
   location: text;
   name: text;
 };
type DashboardStats = 
 record {
   auditCompletion: nat;
   complianceBreakdown: ComplianceBreakdown;
   environmentalDeviations: nat;
   highRiskAlertDetails: vec HighRiskAlertDetail;
   highRiskCount: nat;
   incidentTrendByMonth: vec IncidentTrendMonth;
   ltifr: float64;
   moduleOpenCounts: ModuleOpenCounts;
   nearMissCount: nat;
   openPermits: nat;
   safetyScore: nat;
   safetyScoreSplit: SafetyScoreSplit;
   totalIncidents: nat;
   trainingCompliance: nat;
 };
type ComplianceBreakdown = 
 record {
   iso14001: nat;
   iso45001: nat;
   legalCompliance: nat;
   ppeCompliance: nat;
 };
type CapaStatus = 
 variant {
   closed;
   inProgress;
   open;
   verified;
 };
type CapaRecord = 
 record {
   actionPlan: text;
   createdAt: Timestamp;
   department: text;
   id: RecordId;
   owner: text;
   rootCause: text;
   status: CapaStatus;
   targetDate: Timestamp;
   title: text;
   updatedAt: Timestamp;
   verificationDetails: opt text;
 };
type AuthSession = 
 record {
   expiresAt: Timestamp;
   token: text;
   userId: UserId;
 };
type AttachmentMeta = 
 record {
   contentType: text;
   id: text;
   name: text;
   size: nat;
   storageHash: text;
   uploadedAt: int;
 };
type ActivityFeedItem = 
 record {
   category: text;
   id: RecordId;
   message: text;
   recipient: opt text;
   recipientRole: opt text;
   timestamp: Timestamp;
 };
service : {
  activateUser: (id: text) -> (Result_1);
  addIncidentAttachment: (incidentId: text, attachment: AttachmentMeta) ->
   (Result_1);
  calculateESGScore: () -> (float64) query;
  createCapa: (capa: CapaRecord) -> (Result_3);
  createDepartment: (dept: DepartmentRecord) -> (Result_3);
  createESGRecord: ("record": ESGRecord) -> (Result_3);
  createEnvironmentRecord: ("record": EnvironmentRecord) -> (Result_3);
  createIncident: (incident: IncidentRecord) -> (Result_3);
  createInspection: (inspection: InspectionRecord) -> (Result_3);
  createObservation: (obs: ObservationRecord) -> (Result_3);
  createPermit: (permit: PermitRecord) -> (Result_3);
  createRisk: (risk: RiskRecord) -> (Result_3);
  createTrainingRecord: ("record": TrainingRecord) -> (Result_3);
  createUser: (user: UserRecord) -> (Result_3);
  deleteCapa: (id: text) -> (Result_1);
  deleteDepartment: (id: text) -> (Result_1);
  deleteESGRecord: (id: text) -> (Result_1);
  deleteEnvironmentRecord: (id: text) -> (Result_1);
  deleteIncident: (id: text) -> (Result_1);
  deleteInspection: (id: text) -> (Result_1);
  deleteObservation: (id: text) -> (Result_1);
  deletePermit: (id: text) -> (Result_1);
  deleteRisk: (id: text) -> (Result_1);
  deleteTrainingRecord: (id: text) -> (Result_1);
  deleteUser: (id: text) -> (Result_1);
  getActivityFeed: () -> (vec ActivityFeedItem) query;
  getCapas: () -> (vec CapaRecord) query;
  getDashboardStats: () -> (DashboardStats) query;
  getDepartments: () -> (vec DepartmentRecord) query;
  getESGRecords: () -> (vec ESGRecord) query;
  getESGRecordsByPeriod: (period: text) -> (vec ESGRecord) query;
  getEnvironmentRecords: () -> (vec EnvironmentRecord) query;
  getIncident: (id: text) -> (opt IncidentRecord) query;
  getIncidentAttachments: (incidentId: text) -> (Result_5) query;
  getIncidents: () -> (vec IncidentRecord) query;
  getInspections: () -> (vec InspectionRecord) query;
  getNotifLastRead: () -> (opt int) query;
  getObservations: () -> (vec ObservationRecord) query;
  getPermit: (id: text) -> (opt PermitRecord) query;
  getPermits: () -> (vec PermitRecord) query;
  getRisks: () -> (vec RiskRecord) query;
  getTrainingRecords: () -> (vec TrainingRecord) query;
  getUsers: () -> (vec UserRecord) query;
  login: (email: text, password: text) -> (Result_4);
  markNotificationsRead: () -> ();
  registerCallerPrincipal: (employeeNumber: text) -> ();
  removeIncidentAttachment: (incidentId: text, attachmentId: text) ->
   (Result_1);
  resetPasswordByMobile: (employeeNumber: text, mobileNumber: text) ->
   (Result_3);
  runDeadlineChecks: () -> ();
  seedMockData: () -> (text);
  sendMobileOtp: (email: text, mobileNumber: text) -> (Result_3);
  sendTestNotification: () -> (text);
  updateCapa: (id: text, capa: CapaRecord) -> (Result_1);
  updateCapaStatus: (id: text, status: CapaStatus) -> (Result_1);
  updateESGRecord: ("record": ESGRecord) -> (Result_3);
  updateESGStatus: (id: text, status: ESGStatus, approvedBy: text,
   approvedAt: Timestamp) -> (Result_2);
  updateIncident: (id: text, incident: IncidentRecord) -> (Result_1);
  updateIncidentStatus: (id: text, status: IncidentStatus) -> (Result_1);
  updateInspectionStatus: (id: text, status: InspectionStatus) -> (Result_1);
  updateObservation: (id: text, obs: ObservationRecord) -> (Result_1);
  updateObservationStatus: (id: text, status: ObservationStatus) ->
   (Result_1);
  updatePermitStatus: (id: text, status: PermitStatus, callerId: text,
   callerRole: text) -> (Result_1);
  updateRiskStatus: (id: text, status: RiskStatus) -> (Result_1);
  updateTrainingStatus: (id: text, status: TrainingStatus) -> (Result_1);
  updateUser: (id: text, user: UserRecord) -> (Result_1);
  verifyMobileOtp: (email: text, otp: text) -> (Result);
}
